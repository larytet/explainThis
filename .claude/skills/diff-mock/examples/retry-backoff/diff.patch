diff --git a/payment/client.go b/payment/client.go
index 876f6c4..5579c8a 100644
--- a/payment/client.go
+++ b/payment/client.go
@@ -18,9 +18,20 @@ func NewClient(url string, cfg Config) *Client {
 }
 
 func (c *Client) Charge(ctx context.Context, req ChargeReq) (*ChargeResp, error) {
-	resp, err := c.http.Do(newPost(ctx, c.url, req))
-	if err != nil { return nil, err }
-	return decode(resp)
+	var lastErr error
+	for attempt := 0; attempt <= c.cfg.MaxRetries; attempt++ {
+		resp, err := c.http.Do(newPost(ctx, c.url, req))
+		if err == nil && resp.StatusCode < 500 { return decode(resp) }
+		lastErr = err
+		time.Sleep(backoff(c.cfg.BaseDelay, attempt))
+	}
+	return nil, lastErr
+}
+
+func backoff(base time.Duration, attempt int) time.Duration {
+	d := base << attempt
+	if d > 30*time.Second { return 30 * time.Second }
+	return d
 }
 
 func decode(resp *http.Response) (*ChargeResp, error) {
