diff --git a/tests/LruCacheTest.cpp b/tests/LruCacheTest.cpp
new file mode 100644
index 0000000..8586472
--- /dev/null
+++ b/tests/LruCacheTest.cpp
@@ -0,0 +1,24 @@
+#include <cassert>
+#include <stdexcept>
+#include <string>
+
+#include "../src/LruCache.h"
+
+int main() {
+    LruCache<std::string, int> cache(2);
+    cache.put("a", 1);
+    cache.put("b", 2);
+    assert(cache.get("a").value() == 1);  // "a" is now the most recent
+    cache.put("c", 3);                    // evicts "b"
+    assert(!cache.get("b").has_value());
+    assert(cache.get("c").value() == 3);
+
+    bool threw = false;
+    try {
+        LruCache<int, int> empty(0);
+    } catch (const std::invalid_argument&) {
+        threw = true;
+    }
+    assert(threw);
+    return 0;
+}
